# citation-desk — Development Environment
# Copy this file to .env.development and fill in values.
# NEVER commit .env.development (it is in .gitignore).

# ── Backend URL ───────────────────────────────────────────────────────────────
# Point to the local ttruthdesk-platform dev server when running both repos
# together via docker-compose.dev.yml. Falls back to production if unset.
TTRUTHDESK_BASE_URL=http://localhost:4000

# ── Contract tests ────────────────────────────────────────────────────────────
# Set to "true" to skip the live API contract tests when the backend is
# unavailable locally. Always false in CI.
SKIP_CONTRACT_TESTS=true

# ── Auth (copy from Manus project secrets) ────────────────────────────────────
DATABASE_URL=
JWT_SECRET=dev-secret-change-me
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=
OWNER_NAME=

# ── Built-in Forge (LLM / storage / notifications) ───────────────────────────
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
