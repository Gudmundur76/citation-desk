# citation-desk — Development Dockerfile
# Used by docker-compose.dev.yml in the dev-environment directory.
# Hot-reload via tsx watch; source is mounted as a volume.

FROM node:22-slim

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

# Install dependencies (cached layer — only re-runs when package files change)
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# Copy source (overridden by volume mount in dev)
COPY . .

EXPOSE 3000

CMD ["pnpm", "dev"]
